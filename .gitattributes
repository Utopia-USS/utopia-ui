# Generator output - regenerated per release (RELEASING.md step b), not
# hand-edited. Marked linguist-generated so diffs collapse on GitHub and the
# repo's language stats reflect source, not build products.
tokens/utopia.tokens.json linguist-generated=true
manifest/utopia.manifest.json linguist-generated=true
twin/tokens.css linguist-generated=true
twin/tokens.tailwind.css linguist-generated=true
twin/gallery.html linguist-generated=true
tool/utopia_design_tools/test/goldens/*.g.dart linguist-generated=true

# The twin is emitted and compared byte-exactly (LF); without this, an
# autocrlf=true checkout regenerates a permanent CRLF/LF diff on Windows.
twin/*.html text eol=lf
twin/*.css text eol=lf
twin/*.md text eol=lf
